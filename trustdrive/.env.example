# Copy to .env.local for development. Everything but the secret is optional locally.

# Signs sessions and personal sign-in codes (at least 32 characters, e.g. openssl rand -hex 32).
# Required: without it nobody can sign in. Changing it signs everyone out and replaces every code.
# Print someone's code with: npm run signin-code -- <person id>
TRUSTDRIVE_SECRET=

# Demo mode: the shared access code below also signs in, and "Viewing as" can switch to anyone.
# DEMO_MODE=1
# TRUSTDRIVE_ACCESS_CODE=

# Jev decision API. Without a key (or with JEV_DISABLED=1) everything runs on the rule-based fallbacks.
JEV_API_KEY=
# JEV_API_URL=https://jevtypesafeai.com/api/v1/decide
# JEV_DISABLED=1

# "Reset demo data" wipes the database: on by default with npm run dev, off in production unless set.
# ALLOW_DEMO_RESET=1

# Database. Without DATABASE_URL an embedded Postgres (PGlite) is stored in data/pglite.
# For example: postgresql://USER:PASSWORD@localhost:5432/trustdrive
# DATABASE_URL=
# PG_POOL_SIZE=5
# MIGRATE_ON_START=true     # false when migrations run as a separate job
# SEED_DEMO_DATA=true       # false for real data

# Development: extra hostnames allowed to open the dev server (this machine's own network addresses
# are allowed automatically), e.g. a tunnel: ALLOWED_DEV_ORIGINS=my-tunnel.example.com
# ALLOWED_DEV_ORIGINS=
